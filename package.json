{
  "name": "rust-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "ng serve --host 127.0.0.1",
    "dev:server": "cargo run --locked -p rust-lab-server",
    "runner:build": "docker build --tag rust-lab-runner:stable runner",
    "build": "ng build && cargo build --release -p rust-lab-server --locked",
    "build:client": "ng build",
    "build:server": "cargo build --release -p rust-lab-server --locked",
    "serve": "cargo run --release -p rust-lab-server --locked",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
